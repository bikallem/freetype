///|
test "PCF: loads through public API" {
  let face = from_bytes(load_minimal_pcf())
  inspect(face.family_name(), content="Minimal")
  inspect(face.style_name(), content="Regular")
  inspect(face.num_glyphs(), content="3")
  inspect(face.has_fixed_sizes(), content="true")
  inspect(face.is_fixed_width(), content="true")
  inspect(face.charmaps().length(), content="1")
  inspect(face.charmaps()[0].platform_id(), content="3")
  inspect(face.charmaps()[0].encoding_id(), content="1")
}

///|
test "PCF: charmap and bitmap glyph data" {
  let face = from_bytes(load_minimal_pcf())
  inspect(get_char_index(face, 32U), content="1")
  inspect(get_char_index(face, 65U), content="2")
  inspect(get_char_index(face, 66U), content="0")

  let r = try? load_glyph(face, 2U)
  guard r is Ok(_) else { return }
  inspect(face.glyph().format(), content="Bitmap")
  inspect(face.glyph().bitmap().rows(), content="8")
  inspect(face.glyph().bitmap().width(), content="8")
  inspect(face.glyph().bitmap().buffer().length(), content="8")
  inspect(face.glyph().bitmap().buffer()[0], content="b'\\x18'")
  inspect(face.glyph().metrics().hori_advance(), content="8")
}
