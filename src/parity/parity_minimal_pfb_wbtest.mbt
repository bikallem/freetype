///|
test "parity/minimal.pfb: format" {
  inspect(@base.detect_format(minimal_pfb_data), content="Type1Pfb")
}

///|
test "parity/minimal.pfb: loads" {
  inspect(
    (try? @freetype.from_bytes(minimal_pfb_data)) is Ok(_),
    content="true",
  )
}

///|
test "parity/minimal.pfb: metadata" {
  let f = @freetype.from_bytes(minimal_pfb_data)
  inspect(f.family_name, content="Minimal")
  inspect(f.num_glyphs, content="3")
  inspect(f.units_per_em, content="1000")
  inspect(
    f.ascender,
    content=(
      #|0
    ),
  )
  inspect(
    f.descender,
    content=(
      #|0
    ),
  )
  inspect(
    f.height,
    content=(
      #|0
    ),
  )
}

///|
test "parity/minimal.pfb: bbox" {
  let f = @freetype.from_bytes(minimal_pfb_data)
  inspect(f.bbox.x_min, content="0")
  inspect(f.bbox.y_min, content="-200")
  inspect(f.bbox.x_max, content="500")
  inspect(f.bbox.y_max, content="800")
}

///|
test "parity/minimal.pfb: flags" {
  let f = @freetype.from_bytes(minimal_pfb_data)
  inspect(f.is_scalable(), content="true")
  inspect(f.is_sfnt(), content="false")
  inspect(f.has_horizontal(), content="true")
  inspect(f.has_kerning(), content="false")
}

///|
test "parity/minimal.pfb: charmaps" {
  let f = @freetype.from_bytes(minimal_pfb_data)
  inspect(
    f.charmaps.length(),
    content=(
      #|1
    ),
  )
  if f.charmaps.length() > 0 {
    inspect(
      f.charmaps[0].platform_id,
      content=(
        #|7
      ),
    )
    inspect(
      f.charmaps[0].encoding_id,
      content=(
        #|2
      ),
    )
  }
  if f.charmaps.length() > 1 {
    inspect(f.charmaps[1].platform_id, content="7")
    inspect(f.charmaps[1].encoding_id, content="2")
  }
}

///|
test "parity/minimal.pfb: charmap entries" {
  let f = @freetype.from_bytes(minimal_pfb_data)
  inspect(@freetype.get_char_index(f, 32U), content="1")
  inspect(@freetype.get_char_index(f, 65U), content="2")
  inspect(
    @freetype.get_char_index(f, 160U),
    content=(
      #|0
    ),
  )
}

///|
test "parity/minimal.pfb: glyph 2 outline NO_SCALE" {
  let f = @freetype.from_bytes(minimal_pfb_data)
  @freetype.load_glyph(f, 2U, load_flags=@base.load_no_scale)
  inspect(
    f.glyph.outline.n_points(),
    content=(
      #|4
    ),
  )
  inspect(f.glyph.outline.n_contours(), content="1")
  inspect(
    f.glyph.outline.points[0].x,
    content=(
      #|0
    ),
  )
  inspect(f.glyph.outline.points[0].y, content="0")
  inspect(
    f.glyph.outline.points[1].x,
    content=(
      #|50
    ),
  )
  inspect(
    f.glyph.outline.points[1].y,
    content=(
      #|500
    ),
  )
  inspect(
    f.glyph.outline.points[2].x,
    content=(
      #|250
    ),
  )
  inspect(
    f.glyph.outline.points[2].y,
    content=(
      #|1200
    ),
  )
  inspect(
    f.glyph.metrics.hori_advance,
    content=(
      #|0
    ),
  )
}

///|
test "parity/minimal.pfb: glyph metrics at 16ppem" {
  let f = @freetype.from_bytes(minimal_pfb_data)
  @freetype.set_pixel_sizes(f, 0U, 16U)
  @freetype.load_glyph(f, 2U)
  inspect(
    f.glyph.metrics.hori_advance,
    content=(
      #|0
    ),
  )
}
