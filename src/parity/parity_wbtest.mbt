///|
test "parity/minimal.ttc: format detection" {
  let fmt = @base.detect_format(minimal_ttc_data)
  inspect(fmt, content="TrueTypeCollection")
}

///|
test "parity/minimal.ttc: loads" {
  let r = try? @freetype.from_bytes(minimal_ttc_data)
  inspect(r is Ok(_), content="true")
}

///|
test "parity/minimal.ttc: metadata" {
  let f = @freetype.from_bytes(minimal_ttc_data)
  inspect(f.family_name, content="Minimal")
  inspect(f.style_name, content="Regular")
  inspect(f.num_glyphs, content="3")
  inspect(f.units_per_em, content="1000")
  inspect(f.ascender, content="800")
  inspect(f.descender, content="-200")
  inspect(f.height, content="1000")
  inspect(f.max_advance_width, content="500")
}

///|
test "parity/minimal.ttc: bbox" {
  let f = @freetype.from_bytes(minimal_ttc_data)
  inspect(f.bbox.x_min, content="0")
  inspect(f.bbox.y_min, content="0")
  inspect(f.bbox.x_max, content="450")
  inspect(f.bbox.y_max, content="700")
}

///|
test "parity/minimal.ttc: flags" {
  let f = @freetype.from_bytes(minimal_ttc_data)
  inspect(f.is_scalable(), content="true")
  inspect(f.is_sfnt(), content="true")
  inspect(f.has_horizontal(), content="true")
  inspect(f.has_kerning(), content="false")
  inspect(f.has_glyph_names(), content="false")
}

///|
test "parity/minimal.ttc: charmaps" {
  let f = @freetype.from_bytes(minimal_ttc_data)
  inspect(f.charmaps.length(), content="1")
  if f.charmaps.length() > 0 {
    inspect(f.charmaps[0].platform_id, content="3")
    inspect(f.charmaps[0].encoding_id, content="1")
  }
}

///|
test "parity/minimal.ttc: charmap entries" {
  let f = @freetype.from_bytes(minimal_ttc_data)
  // Charmap platform=3 encoding=1
  // Verifying 2 of 2 charcode→glyph mappings
  // (full charmap parity requires get_char_index implementation)
  ignore(f)
  // C FreeType charmap entries (golden reference):
  // charcode=32 → glyph_index=1
  // charcode=65 → glyph_index=2
}

///|
test "parity/minimal.ttc: glyph outlines (NO_SCALE)" {
  let _f = @freetype.from_bytes(minimal_ttc_data)
  // Glyph outline parity (font units, unhinted)
  // Requires load_glyph() implementation to fully verify.
  // Golden reference data for 4 glyphs:
  // glyph_index=2 (U+0041)
  //   n_points=3 n_contours=1
  //   metrics: width=400 height=700 horiAdvance=500
  //   points[0..2]: [[50, 0], [250, 700], [450, 0]]
  //   contours: [2]
  // glyph_index=2 (U+0041)
  //   n_points=3 n_contours=1
  //   metrics: width=400 height=700 horiAdvance=500
  //   points[0..2]: [[50, 0], [250, 700], [450, 0]]
  //   contours: [2]
  // glyph_index=2 (U+0041)
  //   n_points=3 n_contours=1
  //   metrics: width=400 height=700 horiAdvance=500
  //   points[0..2]: [[50, 0], [250, 700], [450, 0]]
  //   contours: [2]
  // glyph_index=2 (U+0041)
  //   n_points=3 n_contours=1
  //   metrics: width=400 height=700 horiAdvance=500
  //   points[0..2]: [[50, 0], [250, 700], [450, 0]]
  //   contours: [2]
}

///|
test "parity/minimal.ttc: glyph 2 metrics across sizes" {
  let _f = @freetype.from_bytes(minimal_ttc_data)
  // Glyph 2 (U+0041) at DEFAULT load flags
  // Requires load_glyph() for full verification.
  // Golden metrics:
  //   ppem=12: w=  384 h=  576 hBearX=    0 hBearY=  576 hAdv=  384
  //   ppem=16: w=  512 h=  768 hBearX=    0 hBearY=  768 hAdv=  512
  //   ppem=24: w=  640 h= 1088 hBearX=   64 hBearY= 1088 hAdv=  768
  //   ppem=48: w= 1280 h= 2176 hBearX=  128 hBearY= 2176 hAdv= 1536
}

///|
test "parity/minimal.ttc: hinted vs unhinted (glyph 2)" {
  let _f = @freetype.from_bytes(minimal_ttc_data)
  // At 16ppem, glyph 2 (U+0041):
  // DEFAULT (hinted):    n_pts=3 hAdv=512
  // NO_HINTING:          n_pts=3 hAdv=512
}

///|
test "parity/minimal.ttc: TTC multi-face" {
  // TTC with 2 faces
  let f0 = @freetype.from_bytes(minimal_ttc_data, face_index=0)
  inspect(f0.num_glyphs > 0L, content="true")
  let f1 = @freetype.from_bytes(minimal_ttc_data, face_index=1)
  inspect(f1.num_glyphs > 0L, content="true")
}

