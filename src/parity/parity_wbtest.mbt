///|
test "parity/minimal.pfb: format detection" {
  let fmt = @base.detect_format(minimal_pfb_data)
  inspect(fmt, content="Type1Pfb")
}

///|
test "parity/minimal.pfb: loads" {
  let r = try? @freetype.from_bytes(minimal_pfb_data)
  inspect(r is Ok(_), content="true")
}

///|
test "parity/minimal.pfb: metadata" {
  let f = @freetype.from_bytes(minimal_pfb_data)
  inspect(f.family_name, content="Minimal")
  inspect(
    f.style_name,
    content=(
      #|
    ),
  )
  inspect(
    f.num_glyphs,
    content=(
      #|0
    ),
  )
  inspect(
    f.units_per_em,
    content=(
      #|0
    ),
  )
  inspect(
    f.ascender,
    content=(
      #|0
    ),
  )
  inspect(
    f.descender,
    content=(
      #|0
    ),
  )
  inspect(
    f.height,
    content=(
      #|0
    ),
  )
  inspect(
    f.max_advance_width,
    content=(
      #|0
    ),
  )
}

///|
test "parity/minimal.pfb: bbox" {
  let f = @freetype.from_bytes(minimal_pfb_data)
  inspect(f.bbox.x_min, content="0")
  inspect(f.bbox.y_min, content="-200")
  inspect(f.bbox.x_max, content="500")
  inspect(f.bbox.y_max, content="800")
}

///|
test "parity/minimal.pfb: flags" {
  let f = @freetype.from_bytes(minimal_pfb_data)
  inspect(f.is_scalable(), content="true")
  inspect(f.is_sfnt(), content="false")
  inspect(f.has_horizontal(), content="true")
  inspect(f.has_kerning(), content="false")
  inspect(f.has_glyph_names(), content="true")
}

///|
test "parity/minimal.pfb: charmaps" {
  let f = @freetype.from_bytes(minimal_pfb_data)
  inspect(
    f.charmaps.length(),
    content=(
      #|0
    ),
  )
  if f.charmaps.length() > 0 {
    inspect(f.charmaps[0].platform_id, content="3")
    inspect(f.charmaps[0].encoding_id, content="1")
  }
  if f.charmaps.length() > 1 {
    inspect(f.charmaps[1].platform_id, content="7")
    inspect(f.charmaps[1].encoding_id, content="2")
  }
}

///|
test "parity/minimal.pfb: charmap entries" {
  let f = @freetype.from_bytes(minimal_pfb_data)
  // Charmap platform=3 encoding=1
  // Verifying 3 of 3 charcode→glyph mappings
  // (full charmap parity requires get_char_index implementation)
  ignore(f)
  // C FreeType charmap entries (golden reference):
  // charcode=32 → glyph_index=1
  // charcode=65 → glyph_index=2
  // charcode=160 → glyph_index=1
}

///|
test "parity/minimal.pfb: glyph outlines (NO_SCALE)" {
  let _f = @freetype.from_bytes(minimal_pfb_data)
  // Glyph outline parity (font units, unhinted)
  // Requires load_glyph() implementation to fully verify.
  // Golden reference data for 4 glyphs:
  // glyph_index=2 (U+0041)
  //   n_points=3 n_contours=1
  //   metrics: width=400 height=700 horiAdvance=500
  //   points[0..2]: [[50, 0], [250, 700], [450, 0]]
  //   contours: [2]
  // glyph_index=2 (U+0041)
  //   n_points=3 n_contours=1
  //   metrics: width=400 height=700 horiAdvance=500
  //   points[0..2]: [[50, 0], [250, 700], [450, 0]]
  //   contours: [2]
  // glyph_index=2 (U+0041)
  //   n_points=3 n_contours=1
  //   metrics: width=400 height=700 horiAdvance=500
  //   points[0..2]: [[50, 0], [250, 700], [450, 0]]
  //   contours: [2]
  // glyph_index=2 (U+0041)
  //   n_points=3 n_contours=1
  //   metrics: width=400 height=700 horiAdvance=500
  //   points[0..2]: [[50, 0], [250, 700], [450, 0]]
  //   contours: [2]
}

///|
test "parity/minimal.pfb: glyph 2 metrics across sizes" {
  let _f = @freetype.from_bytes(minimal_pfb_data)
  // Glyph 2 (U+0041) at DEFAULT load flags
  // Requires load_glyph() for full verification.
  // Golden metrics:
  //   ppem=12: w=  384 h=  576 hBearX=    0 hBearY=  576 hAdv=  384
  //   ppem=16: w=  512 h=  768 hBearX=    0 hBearY=  768 hAdv=  512
  //   ppem=24: w=  640 h= 1088 hBearX=   64 hBearY= 1088 hAdv=  768
  //   ppem=48: w= 1280 h= 2176 hBearX=  128 hBearY= 2176 hAdv= 1536
}

///|
test "parity/minimal.pfb: hinted vs unhinted (glyph 2)" {
  let _f = @freetype.from_bytes(minimal_pfb_data)
  // At 16ppem, glyph 2 (U+0041):
  // DEFAULT (hinted):    n_pts=3 hAdv=512
  // NO_HINTING:          n_pts=3 hAdv=512
}

